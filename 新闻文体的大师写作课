<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新闻文体的写作大师课 - 交互式学习与实战平台</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .highlight-lead {
            background-color: #fef08a;
            padding: 2px 4px;
            border-radius: 4px;
        }
        .highlight-vocab {
            background-color: #bbf7d0;
            padding: 2px 4px;
            border-radius: 4px;
            font-weight: 600;
        }
        .highlight-connective {
            background-color: #bae6fd;
            padding: 2px 4px;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">

    <div id="app" class="flex-1 flex flex-col min-h-screen">
        
        <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md border-b border-slate-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-16">
                    <div class="flex items-center gap-3">
                        <div class="bg-brand-600 text-white p-2 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-newspaper text-xl"></i>
                        </div>
                        <div>
                            <h1 class="font-bold text-lg leading-tight">新闻文体写作大师课</h1>
                            <p class="text-[11px] text-slate-400">Journalistic Writing Masterclass & Interactive Lab</p>
                        </div>
                    </div>

                    <!-- Navigation Tabs -->
                    <nav class="hidden md:flex space-x-1">
                        <button @click="currentTab = 'theory'" :class="['px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2', currentTab === 'theory' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white']">
                            <i class="fa-solid fa-sitemap"></i> 1. 倒金字塔与流程
                        </button>
                        <button @click="currentTab = 'vocab'" :class="['px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2', currentTab === 'vocab' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white']">
                            <i class="fa-solid fa-book-bookmark"></i> 2. 词汇与过渡表
                        </button>
                        <button @click="currentTab = 'workbench'" :class="['px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2', currentTab === 'workbench' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white']">
                            <i class="fa-solid fa-pen-to-square"></i> 3. 写作任务与构思
                        </button>
                        <button @click="currentTab = 'quiz'" :class="['px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2', currentTab === 'quiz' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white']">
                            <i class="fa-solid fa-list-check"></i> 4. 互动测试中心
                        </button>
                        <button @click="currentTab = 'model'" :class="['px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2', currentTab === 'model' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white']">
                            <i class="fa-solid fa-award"></i> 5. 范文与评分量表
                        </button>
                        <button @click="currentTab = 'teacher'" :class="['px-3 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2', currentTab === 'teacher' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white']">
                            <i class="fa-solid fa-chalkboard-user"></i> 6. 教师后台
                        </button>
                    </nav>

                    <!-- Mobile Menu Button -->
                    <div class="md:hidden flex items-center">
                        <button @click="mobileMenuOpen = !mobileMenuOpen" class="p-2 rounded-md text-slate-400 hover:text-white hover:bg-slate-800">
                            <i :class="['fa-solid', mobileMenuOpen ? 'fa-xmark' : 'fa-bars']"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Navigation Drawer -->
            <div v-if="mobileMenuOpen" class="md:hidden bg-slate-900 border-t border-slate-800 px-2 pt-2 pb-3 space-y-1">
                <button @click="currentTab = 'theory'; mobileMenuOpen = false" :class="['w-full text-left px-3 py-2 rounded-md text-base font-medium flex items-center gap-2', currentTab === 'theory' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800']">
                    <i class="fa-solid fa-sitemap w-5"></i> 1. 倒金字塔与流程
                </button>
                <button @click="currentTab = 'vocab'; mobileMenuOpen = false" :class="['w-full text-left px-3 py-2 rounded-md text-base font-medium flex items-center gap-2', currentTab === 'vocab' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800']">
                    <i class="fa-solid fa-book-bookmark w-5"></i> 2. 词汇与过渡表
                </button>
                <button @click="currentTab = 'workbench'; mobileMenuOpen = false" :class="['w-full text-left px-3 py-2 rounded-md text-base font-medium flex items-center gap-2', currentTab === 'workbench' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800']">
                    <i class="fa-solid fa-pen-to-square w-5"></i> 3. 写作任务与构思
                </button>
                <button @click="currentTab = 'quiz'; mobileMenuOpen = false" :class="['w-full text-left px-3 py-2 rounded-md text-base font-medium flex items-center gap-2', currentTab === 'quiz' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800']">
                    <i class="fa-solid fa-list-check w-5"></i> 4. 互动测试中心
                </button>
                <button @click="currentTab = 'model'; mobileMenuOpen = false" :class="['w-full text-left px-3 py-2 rounded-md text-base font-medium flex items-center gap-2', currentTab === 'model' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800']">
                    <i class="fa-solid fa-award w-5"></i> 5. 范文与评分量表
                </button>
                <button @click="currentTab = 'teacher'; mobileMenuOpen = false" :class="['w-full text-left px-3 py-2 rounded-md text-base font-medium flex items-center gap-2', currentTab === 'teacher' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800']">
                    <i class="fa-solid fa-chalkboard-user w-5"></i> 6. 教师后台
                </button>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">

            <section v-if="currentTab === 'theory'" class="space-y-8 animate-fade-in">
                <!-- Section Header -->
                <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <span class="bg-brand-50 text-brand-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">核心理论</span>
                        <h2 class="text-2xl font-bold text-slate-900 mt-1">倒金字塔结构与新闻写作流程</h2>
                        <p class="text-sm text-slate-600 mt-1">掌握“结果先行”的新闻叙事逻辑，了解主编剪裁原则与规范写作三步法。</p>
                    </div>
                    <div class="flex items-center gap-2 bg-slate-100 p-2 rounded-lg text-xs font-medium text-slate-700">
                        <i class="fa-solid fa-circle-info text-brand-600 text-sm"></i>
                        <span>按重要性递减排列信息（Most Important → Least Important）</span>
                    </div>
                </div>

                <!-- Interactive Inverted Pyramid Breakdown -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <!-- Left: Inverted Pyramid Visual -->
                    <div class="lg:col-span-7 bg-white rounded-xl p-6 shadow-sm border border-slate-200 space-y-4">
                        <h3 class="font-bold text-slate-900 border-l-4 border-brand-500 pl-3">新闻倒金字塔结构分解图 (Inverted Pyramid)</h3>
                        
                        <div class="space-y-3 py-2">
                            <!-- Tier 1: Headline & Lead -->
                            <div class="bg-amber-500 text-white p-4 rounded-t-xl shadow-sm cursor-pointer transform hover:-translate-y-0.5 transition-transform" @click="activeTheoryDetail = 'lead'">
                                <div class="flex justify-between items-center font-bold">
                                    <span><i class="fa-solid fa-bullhorn mr-2"></i> 1. 新闻标题 & 导语 (Headline & Lead)</span>
                                    <span class="text-xs bg-amber-600 px-2 py-0.5 rounded">最核心 / 5W1H</span>
                                </div>
                                <p class="text-xs text-amber-100 mt-1">直接交代最震撼的新闻结果：Who, What, When, Where, Why, How。</p>
                            </div>

                            <!-- Tier 2: Important Details & Turning Points -->
                            <div class="bg-amber-600 text-white p-4 rounded-none shadow-sm mx-4 cursor-pointer transform hover:-translate-y-0.5 transition-transform" @click="activeTheoryDetail = 'body'">
                                <div class="flex justify-between items-center font-bold">
                                    <span><i class="fa-solid fa-list-ol mr-2"></i> 2. 核心过程与转折点 (Key Details)</span>
                                    <span class="text-xs bg-amber-700 px-2 py-0.5 rounded">重要细节</span>
                                </div>
                                <p class="text-xs text-amber-100 mt-1">展开比赛关键节点（进球、扳平、绝杀），解释事情如何发生。</p>
                            </div>

                            <!-- Tier 3: Background & Quotes -->
                            <div class="bg-amber-700 text-white p-4 rounded-b-xl shadow-sm mx-8 cursor-pointer transform hover:-translate-y-0.5 transition-transform" @click="activeTheoryDetail = 'bg'">
                                <div class="flex justify-between items-center font-bold">
                                    <span><i class="fa-solid fa-quote-left mr-2"></i> 3. 赛后声音与背景 (Quotes & Background)</span>
                                    <span class="text-xs bg-amber-800 px-2 py-0.5 rounded">次要信息</span>
                                </div>
                                <p class="text-xs text-amber-100 mt-1">引用教练/队员原话，延伸历史战绩，提供更丰富的维度。</p>
                            </div>
                        </div>

                        <!-- Red-Pen Principle (主编剪裁原则) Banner -->
                        <div class="p-4 bg-slate-900 text-slate-200 rounded-lg text-xs space-y-2 border border-slate-800">
                            <div class="font-bold text-amber-400 flex items-center gap-2 text-sm">
                                <i class="fa-solid fa-scissors"></i> “主编剪裁原则” (The Red-Pen Principle)
                            </div>
                            <p class="leading-relaxed">
                                报纸版面有限。若编辑从底部剪掉后两个段落，文章依然能够<strong>独立成篇</strong>且<strong>核心新闻事实毫发无损</strong>。这就是倒金字塔结构的最强实用价值！
                            </p>
                        </div>
                    </div>

                    <!-- Right: Dynamic Detail Inspector -->
                    <div class="lg:col-span-5 bg-white rounded-xl p-6 shadow-sm border border-slate-200 space-y-4">
                        <h3 class="font-bold text-slate-900 border-l-4 border-brand-500 pl-3">结构层级详细拆解</h3>

                        <div v-if="activeTheoryDetail === 'lead'" class="space-y-3 animate-fade-in text-xs">
                            <div class="p-3 bg-amber-50 text-amber-900 rounded-lg font-semibold border border-amber-200">
                                <i class="fa-solid fa-circle-play text-amber-600 mr-1"></i> 导语 (The Lead) 规则
                            </div>
                            <ul class="list-disc list-inside space-y-2 text-slate-700 leading-relaxed">
                                stroke-width
                                <li><strong>开门见山：</strong> 严禁流水账陈述。用第一句话直接呈现胜负与比分。</li>
                                <li><strong>包含 5W1H 要素：</strong> 谁(Who)、何时(When)、何地(Where)、什么事(What)、为什么(Why)、如何发生(How)。</li>
                                <li><strong>推荐字数：</strong> 50 - 70 字左右，语言高度精炼。</li>
                            </ul>
                        </div>

                        <div v-if="activeTheoryDetail === 'body'" class="space-y-3 animate-fade-in text-xs">
                            <div class="p-3 bg-amber-50 text-amber-900 rounded-lg font-semibold border border-amber-200">
                                <i class="fa-solid fa-circle-play text-amber-600 mr-1"></i> 主体段落 (Body Paragraphs) 规则
                            </div>
                            <ul class="list-disc list-inside space-y-2 text-slate-700 leading-relaxed">
                                <li><strong>按重要性递减：</strong> 先写打破僵局与扳平，再写绝杀或胜负判定节点。</li>
                                <li><strong>使用过渡词：</strong> 使用“易边再战”、“随着比赛深入”等连接词使段落自然过渡。</li>
                                <li><strong>避免冗长无意义过程：</strong> 剔除普通中场传球等非核心镜头。</li>
                            </ul>
                        </div>

                        <div v-if="activeTheoryDetail === 'bg'" class="space-y-3 animate-fade-in text-xs">
                            <div class="p-3 bg-amber-50 text-amber-900 rounded-lg font-semibold border border-amber-200">
                                <i class="fa-solid fa-circle-play text-amber-600 mr-1"></i> 结尾与引用 (Background & Quotes)
                            </div>
                            <ul class="list-disc list-inside space-y-2 text-slate-700 leading-relaxed">
                                <li><strong>直接/间接引用：</strong> 赛后教练与主力的评价能够增强新闻真实感与温度。</li>
                                <li><strong>背景补充：</strong> 总结球队历史突破（如“打破20年不胜魔咒”、“首次挺进八强”）。</li>
                                <li><strong>客观中立：</strong> 记者情绪通过引用的原话间接表达，严禁出现“我觉得/我非常激动”。</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Three-Step Workflow Cards -->
                <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 space-y-4">
                    <h3 class="font-bold text-slate-900 border-l-4 border-brand-500 pl-3">规范新闻写作“三步工作法”</h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white font-bold flex items-center justify-center text-sm">1</div>
                            <h4 class="font-bold text-slate-900 text-sm">第一步：5W1H 提炼与排序</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">从混乱的比赛素材中快速挑出核心事实，圈定时间、地点、对阵双方及比分，明确最震撼的爆点（如加时绝杀）。</p>
                        </div>

                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white font-bold flex items-center justify-center text-sm">2</div>
                            <h4 class="font-bold text-slate-900 text-sm">第二步：倒金字塔段落组装</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">编写动词强烈的标题与导语段，主体段分层次写转折节点，并在结尾加入赛后采访原话与历史背景。</p>
                        </div>

                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                            <div class="w-8 h-8 rounded-full bg-brand-600 text-white font-bold flex items-center justify-center text-sm">3</div>
                            <h4 class="font-bold text-slate-900 text-sm">第三步：红笔自我诊断与客化</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">彻底清除“我/我觉得”等第一人称，替换为体育高级成语（如“先拔头筹”、“锁定胜局”），并核对字数（250-300字）。</p>
                        </div>
                    </div>
                </div>
            </section>

            <section v-if="currentTab === 'vocab'" class="space-y-6 animate-fade-in">
                <!-- Search & Category Header -->
                <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 space-y-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-100 pb-4">
                        <div>
                            <span class="bg-emerald-50 text-emerald-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase">语言工具箱</span>
                            <h2 class="text-2xl font-bold text-slate-900 mt-1">新闻核心词汇与逻辑过渡句表</h2>
                            <p class="text-xs text-slate-500">积累体育新闻的高频精准成语，告别口语化与平铺直叙。</p>
                        </div>

                        <!-- Search Input -->
                        <div class="w-full md:w-72 relative">
                            <input v-model="vocabSearch" type="text" placeholder="搜索词汇、英文或释义..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                        </div>
                    </div>

                    <!-- Category Pills -->
                    <div class="flex flex-wrap gap-2 text-xs">
                        <button @click="vocabFilterCategory = 'ALL'" :class="['px-3 py-1.5 rounded-full font-medium transition-colors', vocabFilterCategory === 'ALL' ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200']">
                            全部词汇 ({{ vocabList.length }})
                        </button>
                        <button @click="vocabFilterCategory = '1'" :class="['px-3 py-1.5 rounded-full font-medium transition-colors', vocabFilterCategory === '1' ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200']">
                            1. 比赛阶段与胜负 (5)
                        </button>
                        <button @click="vocabFilterCategory = '2'" :class="['px-3 py-1.5 rounded-full font-medium transition-colors', vocabFilterCategory === '2' ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200']">
                            2. 关键进球与节点 (5)
                        </button>
                        <button @click="vocabFilterCategory = '3'" :class="['px-3 py-1.5 rounded-full font-medium transition-colors', vocabFilterCategory === '3' ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200']">
                            3. 局势与对抗 (5)
                        </button>
                        <button @click="vocabFilterCategory = '4'" :class="['px-3 py-1.5 rounded-full font-medium transition-colors', vocabFilterCategory === '4' ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200']">
                            4. 表现与态度 (5)
                        </button>
                    </div>
                </div>

                <!-- Vocabulary Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div v-for="item in filteredVocab" :key="item.id" class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 space-y-2 hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start">
                            <span class="text-base font-bold text-brand-700">{{ item.word }}</span>
                            <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-mono">{{ item.english }}</span>
                        </div>
                        <p class="text-xs text-slate-600 leading-relaxed"><strong class="text-slate-800">释义：</strong> {{ item.definition }}</p>
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100 text-xs space-y-1">
                            <div class="text-slate-800"><i class="fa-solid fa-pen-clip text-brand-500 mr-1"></i> {{ item.exampleZh }}</div>
                            <div class="text-slate-400 italic text-[11px]">{{ item.exampleEn }}</div>
                        </div>
                    </div>
                </div>

                <!-- Transition Phrases Guide Card -->
                <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 space-y-4">
                    <h3 class="font-bold text-slate-900 border-l-4 border-brand-500 pl-3">新闻写作常用过渡词与连接句指南</h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                        <div class="bg-blue-50/50 p-4 rounded-xl border border-blue-100 space-y-2">
                            <div class="font-bold text-blue-900 flex items-center gap-1.5">
                                <i class="fa-solid fa-clock text-blue-600"></i> 时间与比赛推进过渡
                            </div>
                            <ul class="list-disc list-inside space-y-1 text-slate-700">
                                <li>开场仅XX分钟...</li>
                                <li>易边再战，落后的XX队...</li>
                                <li>随着比赛深入/进入加时赛...</li>
