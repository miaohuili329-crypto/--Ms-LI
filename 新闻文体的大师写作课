                        if (this.check5W1H) strengths.push("导语完整覆盖了时间（6月28日）、地点（大都会体育场）、球队与比分5W1H要素。");
                        else improvements.push("导语段建议补齐大都会体育场、6月28日晚等核心5W1H时间地点要素。");

                        if (this.checkObjectiveTone) strengths.push("全程保持第三方资深记者视角，消除了第一人称（我/觉得）。");
                        else improvements.push("文中检测到第一人称或主观口语，请替换为客观事实陈述或赛后声音引用。");

                        if (this.detectedVocab.length >= 3) strengths.push(`高级新闻词汇丰富：成功运用了【${this.detectedVocab.join("、")}】。`);
                        else improvements.push("成语与高级体育词汇偏少，建议加入“先拔头筹”、“顽强扳平”、“绝杀”等专有词。");

                        if (this.checkWordCount) strengths.push("篇幅控制得当，符合250-300字标准新闻快讯要求。");
                        else improvements.push(`当前字数为${this.draftWordCount}字，请调整至250-300字的规定区间。`);

                        this.submissionFeedback = {
                            totalScore: total,
                            gradeLevel: gradeLevel,
                            breakdown: {
                                headline: hScore,
                                lead: lScore,
                                structure: sScore,
                                tone: tScore,
                                vocab: vScore
                            },
                            strengths: strengths,
                            improvements: improvements
                        };
                    }, 800);
                },
                resetQuiz() {
                    this.pyQuizQuestions.forEach(q => q.userSelected = null);
                    this.quizVocabQuestions.forEach(q => q.userAnswer = '');
                    this.quizRewriteQuestions.forEach(q => {
                        q.userRewrite = '';
                        q.showAnswer = false;
                        q.selfGraded = false;
                    });
                    this.quizTrans = ['', '', '', ''];
                    this.quizLeadUser = '';
                    this.showQuizLeadModel = false;
                    this.quizLeadGraded = false;
                },
                toggleHighlight(type) {
                    if (type === 'lead') this.highlightLead = !this.highlightLead;
                    if (type === 'vocab') this.highlightVocab = !this.highlightVocab;
                    if (type === 'connective') this.highlightConnective = !this.highlightConnective;
                }
            }
        }).mount('#app');
    </script>
</body>
